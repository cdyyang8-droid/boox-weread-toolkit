<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.tencent.weread" /><package android:name="com.tencent.weread.eink" /><package android:name="com.onyx" /></queries>
    <application android:label="文石微信读书极简首页" android:icon="@drawable/ic_home" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".HomeActivity" android:exported="true" android:launchMode="singleTask" android:excludeFromRecents="true" android:configChanges="orientation|screenSize|screenLayout|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".ControlActivity" android:exported="true" android:label="阅读器设置">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
